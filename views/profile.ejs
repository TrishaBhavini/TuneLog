<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/styles/profile.css">
  <link rel="icon" type="image/x-icon" href="/images/icon.png">
  <title>Spotify Profile</title>
</head>
<body>
  <div class="container">
    <% if(user.images && user.images.length > 0) { %>
      <img class="profile-img" src="<%= user.images[0].url %>" alt="Profile Picture">
    <% } else { %>
      <img class="profile-img" src="images/blank.jpg" alt="Profile Picture">
    <% } %>

    <h1><%= user.display_name %></h1>
    <p><strong>Email:</strong> <%= user.email %></p>
    <p><strong>Spotify ID:</strong> <%= user.id %></p>
    <p class="followers"><strong>Followers:</strong> <%= user.followers.total %></p>
    <p><a href="<%= user.external_urls.spotify %>" target="_blank">View on Spotify</a></p>
    <p><strong>Account Type:</strong> <%= user.product %></p>
    <a href="/saved_albums" class="btn">Check Out Your Saved Albums</a>
    <br>
    <h3>Your Album Reviews</h3>
<ul>
  <% if (albumReviews.length > 0) { %>
    <table>
      <thead>
        <td>Album Name</td>
        <td>Album Review</td>
      </thead>
    <% albumReviews.forEach(review => { %>
      <tr>
        <a href="/album/<%=review.album_id%>"><td><%=review.album_name%></td></a>
        <td><%=review.review%></td>
      </tr>
    <% }) %>
    </table>
  <% } else { %>
    <li>No reviews yet.</li>
  <% } %>
</ul>

<h3>Your Track Reviews</h3>
<ul>
  <% if (trackReviews.length > 0) { %>
    <table>
      <thead>
        <td>Track Name</td>
        <td>Track Review</td>
      </thead>
    <% trackReviews.forEach(review => { %>
      <tr>
        <a href="/album/<%=review.albumID%>"><td><%=review.track_name%></td></a>
        <td><%=review.review%></td>
      </tr>
    <% }) %>
    </table>
  <% } else { %>
    <li>No reviews yet.</li>
  <% } %>
</ul>
  </div>
</body>
</html>
